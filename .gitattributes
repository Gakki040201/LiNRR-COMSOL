* text=auto
*.ps1 text eol=crlf
*.java text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.mph filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Byte-exact project archival. LFS filter attributes above still apply to
# matching binaries; this rule prevents line-ending normalization of run evidence.
archive/** binary
data/raw_experimental/** binary
